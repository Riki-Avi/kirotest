@{
    ViewData["Title"] = "Crear Cuenta — Kiro Code Lab";
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="~/css/style.css" asp-append-version="true" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
</head>
<body>
    <div class="auth-wrapper">
        <div class="auth-card-container">
            <div class="auth-header-logo">
                <div class="auth-logo-badge">
                    <span>⚡</span>
                    <span style="background: linear-gradient(135deg, #818CF8, #C084FC); -webkit-background-clip: text; -webkit-text-fill-color: transparent;">Kiro Code Lab</span>
                </div>
                <p class="auth-subtitle">Crea tu cuenta gratuita para desbloquear el compilador C# en vivo, pruebas y el Tutor IA</p>
            </div>

            <!-- Error / Success Alert -->
            <div class="auth-alert hidden" id="authAlert">
                <span>⚠️</span>
                <span id="authAlertText">Error al registrarse</span>
            </div>

            <!-- Google OAuth Button -->
            <button id="googleRegisterBtn" class="btn-google">
                <svg width="18" height="18" viewBox="0 0 24 24">
                    <path fill="#EA4335" d="M12 5c1.6 0 3 .6 4.1 1.6l3.1-3.1C17.3 1.7 14.8 1 12 1 7.5 1 3.7 3.6 1.9 7.3l3.7 2.9C6.5 7.3 9 5 12 5z"/>
                    <path fill="#4285F4" d="M23.5 12.3c0-.8-.1-1.6-.2-2.3H12v4.5h6.5c-.3 1.5-1.1 2.8-2.4 3.7l3.7 2.9c2.2-2 3.7-5 3.7-8.8z"/>
                    <path fill="#FBBC05" d="M5.6 14.8c-.2-.7-.4-1.5-.4-2.3s.2-1.6.4-2.3L1.9 7.3C.7 9.7 0 12.3 0 15s.7 5.3 1.9 7.7l3.7-2.9c-.8-.7-1.4-1.7-2-2.8z"/>
                    <path fill="#34A853" d="M12 23c3.2 0 6-1.1 8-3l-3.7-2.9c-1.1.7-2.5 1.2-4.3 1.2-3 0-5.5-2.3-6.4-5.2L1.9 16C3.7 19.7 7.5 22.3 12 23z"/>
                </svg>
                <span>Registrarse con Google</span>
            </button>

            <div class="auth-divider">
                <span>O regístrate con tu correo</span>
            </div>

            <!-- Form Email / Password -->
            <form id="emailRegisterForm" class="auth-form">
                <div class="input-with-icon">
                    <span class="input-icon">✉️</span>
                    <input type="email" id="emailInput" placeholder="tu-correo@ejemplo.com" required autocomplete="email">
                </div>
                <div class="input-with-icon">
                    <span class="input-icon">🔒</span>
                    <input type="password" id="passwordInput" placeholder="Crea una contraseña segura" minlength="6" required autocomplete="new-password">
                </div>
                <button type="submit" class="btn-auth-submit" id="submitRegisterBtn">
                    ✨ Crear Cuenta Gratis
                </button>
            </form>

            <div class="auth-footer">
                <div>¿Ya tienes una cuenta? <a href="/Auth/Login">Iniciar Sesión</a></div>
                <div style="margin-top: 4px;"><a href="/" style="color: var(--text-dim); font-size: 12px;">← Volver al Editor (Modo Invitado)</a></div>
            </div>
        </div>
    </div>

    <!-- Supabase JS Client -->
    <script src="https://cdn.jsdelivr.net/npm/@@supabase/supabase-js@2"></script>
    <script>
        const SUPABASE_URL = "https://bzaifpevfuwlaznmhiee.supabase.co";
        const SUPABASE_ANON_KEY = "sb_publishable_xoU3gGiIKuchm6oTBhr8EQ_eb7sUD2a";
        const supabaseClient = supabase.createClient(SUPABASE_URL, SUPABASE_ANON_KEY);

        const googleBtn = document.getElementById('googleRegisterBtn');
        const emailForm = document.getElementById('emailRegisterForm');
        const submitBtn = document.getElementById('submitRegisterBtn');
        const authAlert = document.getElementById('authAlert');
        const authAlertText = document.getElementById('authAlertText');

        function showAlert(msg, isSuccess = false) {
            if (authAlert && authAlertText) {
                authAlertText.textContent = msg;
                authAlert.style.background = isSuccess ? "rgba(16, 185, 129, 0.15)" : "rgba(239, 68, 68, 0.12)";
                authAlert.style.borderColor = isSuccess ? "rgba(16, 185, 129, 0.3)" : "rgba(239, 68, 68, 0.3)";
                authAlert.style.color = isSuccess ? "#6EE7B7" : "#FCA5A5";
                authAlert.classList.remove('hidden');
            }
        }

        function hideAlert() {
            if (authAlert) authAlert.classList.add('hidden');
        }

        // Google OAuth
        googleBtn.onclick = async () => {
            hideAlert();
            try {
                const { error } = await supabaseClient.auth.signInWithOAuth({
                    provider: 'google',
                    options: { redirectTo: window.location.origin + '/' }
                });
                if (error) throw error;
            } catch (err) {
                showAlert("Error con Google: " + err.message);
            }
        };

        // Email / Password Register
        emailForm.onsubmit = async (e) => {
            e.preventDefault();
            hideAlert();
            const email = document.getElementById('emailInput').value.trim();
            const password = document.getElementById('passwordInput').value;

            if (!email || !password) {
                showAlert("Por favor completa todos los campos.");
                return;
            }

            submitBtn.disabled = true;
            submitBtn.textContent = '⏳ Creando cuenta...';

            try {
                const { data, error } = await supabaseClient.auth.signUp({
                    email: email,
                    password: password
                });

                if (error) throw error;

                if (data?.session) {
                    window.location.href = '/';
                } else {
                    showAlert("🎉 ¡Cuenta creada con éxito! Si se requiere confirmación por correo, revisa tu bandeja de entrada.", true);
                }
            } catch (err) {
                showAlert(err.message || "Error al registrar la cuenta.");
            } finally {
                submitBtn.disabled = false;
                submitBtn.textContent = '✨ Crear Cuenta Gratis';
            }
        };

        // Redirección si ya está autenticado
        supabaseClient.auth.onAuthStateChange((event, session) => {
            if (session?.user) {
                window.location.href = '/';
            }
        });
    </script>
</body>
</html>
