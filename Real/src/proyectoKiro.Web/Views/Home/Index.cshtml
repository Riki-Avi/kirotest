@{
    Layout = null;
    ViewData["Title"] = "CODELAB — Plataforma de Entrevistas Técnicas con IA";
}
<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>@ViewData["Title"]</title>
  <link rel="icon" type="image/svg+xml" href="~/favicon.svg" />
  <meta name="description" content="Plataforma interactiva para practicar ejercicios de entrevistas de código con un tutor IA con contexto completo.">
  
  <!-- Google Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;600;700&family=Cormorant+Garamond:ital,wght@0,400;0,600;1,400&family=JetBrains+Mono:ital,wght@0,300;0,400;0,600;0,700;1,400&family=Space+Grotesk:wght@400;500;600;700&family=Syne:wght@700;800&display=swap" rel="stylesheet">
  
  <link rel="stylesheet" href="~/css/home.css" asp-append-version="true">
</head>
<body>
  <!-- Fixed Canvas Background for Scroll-driven Matraz Pouring & Code Matrix Animation -->
  <canvas id="ascii-canvas"></canvas>

  <!-- HUD Grid & Fixed Overlay Elements -->
  <div class="hud-overlay">
    <div class="crosshair crosshair-tl">+</div>
    <div class="crosshair crosshair-tr">+</div>
    <div class="crosshair crosshair-bl">+</div>
    <div class="crosshair crosshair-br">+</div>

    <div class="coord-label coord-tl">CODELAB // ENGINE 2.0</div>
    <div class="coord-label coord-tr">AI CONTEXT: ACTIVE</div>
    <div class="coord-label coord-bl">FPS: <span id="fps-counter">60</span></div>
    <div class="coord-label coord-br">NODES: <span id="node-counter">4200</span></div>
  </div>

  <!-- Four Corners typography (Fixed) -->
  <div class="corner-letter top-left">C</div>
  <div class="corner-letter top-right">O</div>
  <div class="corner-letter bottom-left">D</div>
  <div class="corner-letter bottom-right">E</div>

  <!-- Top Floating Navigation Pill Bar -->
  <nav class="top-nav-bar">
    <button class="nav-btn logo-btn" id="mode-toggle-btn" title="Cambiar modo de renderizado">
      <span class="symbol">&gt;|&lt;</span>
    </button>

    <div class="status-matrix-container" title="Matriz de estado interactiva">
      <div class="status-matrix">
        <span class="dot active"></span>
        <span class="dot active"></span>
        <span class="dot active"></span>
        <span class="dot active"></span>
        <span class="dot active"></span>
      </div>
    </div>

    <a href="/editor" class="nav-btn">EDITOR</a>
    <a href="/Auth/Login" class="nav-btn" id="navLoginBtn">INGRESAR</a>
    <a href="/Profile" class="nav-btn" id="navProfileBtn" style="display: none;">PERFIL</a>

    <button class="nav-btn menu-btn" id="menu-toggle-btn">
      MENU
    </button>
  </nav>

  <!-- MAIN SCROLLABLE CONTENT CONTAINER -->
  <div class="scroll-content">
    
    <!-- SECTION 1: HERO -->
    <section class="section hero-section" id="hero">
      <div class="hero-container">
        <h1 class="hero-title" id="dragonfly-title">CODELAB</h1>
        <p class="hero-subtitle">ENTREVISTAS TÉCNICAS &bull; ASISTENCIA IA EN TIEMPO REAL</p>
        <div style="margin-top: 1.5rem; display: flex; gap: 1rem; flex-wrap: wrap; justify-content: center; position: relative; z-index: 30;">
          <a href="/editor" class="primary-btn">💻 ENTRAR AL EDITOR</a>
        </div>
      </div>

      <div class="bottom-indicator" id="scroll-indicator">
        <span class="scroll-text">DESLIZA PARA VER LA MAGIA</span>
        <div class="arrow-down">
          <span class="dot-orange"></span>
          <span class="v-symbol">&#9661;</span>
        </div>
      </div>
    </section>

    <!-- SECTION 2: EDITORIAL ABOUT -->
    <section class="section editorial-section" id="about">
      <div class="editorial-container">
        <!-- Section Header Badge & Title -->
        <div class="section-num">01</div>
        <h2 class="editorial-title">SOBRE LA PLATAFORMA</h2>
        <div class="section-tag">SEC-01</div>

        <!-- Paragraphs matching high-end editorial serif styling -->
        <div class="editorial-text-block">
          <p class="p-lead">
            CODELAB te brinda acceso directo a ejercicios reales tomados en entrevistas técnicas de las empresas más exigentes del sector tecnológico.
          </p>

          <div class="ethos-wrapper">
            <span class="ethos-tag">IA TUTOR</span>
            <p class="p-body">
              A diferencia de otras plataformas de práctica, siempre cuentas con una Inteligencia Artificial integrada que analiza tu código en tiempo real, comprende el contexto completo del problema, identifica casos límite y te orienta paso a paso hacia la solución óptima <span class="mono-code">O(n)</span>.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- SECTION 3: FEATURES GRID -->
    <section class="section features-section" id="features">
      <div class="editorial-container">
        <div class="section-num">02</div>
        <h2 class="editorial-title">CARACTERÍSTICAS CLAVE</h2>
        <div class="section-tag">SEC-02</div>

        <div class="features-grid">
          <div class="feature-card">
            <div class="card-num">01 //</div>
            <h3>Ejercicios Reales FAANG</h3>
            <p>Problemas actualizados de Algoritmos, Estructuras de Datos y Programación Dinámica evaluados en pruebas técnicas reales en C#.</p>
          </div>

          <div class="feature-card highlighted-card">
            <div class="card-num">02 //</div>
            <h3>Tutor IA con Contexto Total</h3>
            <p>El asistente conoce el enunciado, tus variables y tus errores, brindándote pistas inteligentes con Gemini 3.5 sin revelarte la solución de golpe.</p>
          </div>

          <div class="feature-card">
            <div class="card-num">03 //</div>
            <h3>Análisis & Compilación Remota</h3>
            <p>Ejecución de código en tiempo real con Judge0 API y validación automatizada de casos de prueba.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- SECTION 4: CODE EDITOR DEMO -->
    <section class="section demo-section" id="demo">
      <div class="editorial-container">
        <div class="section-num">03</div>
        <h2 class="editorial-title">INTERFAZ DE TRABAJO</h2>
        <div class="section-tag">SEC-03</div>

        <div class="mock-editor-window">
          <div class="window-header">
            <span class="mac-dot red"></span>
            <span class="mac-dot yellow"></span>
            <span class="mac-dot green"></span>
            <span class="window-title">TwoSumSolution.cs — CODELAB AI Workspace</span>
          </div>

          <div class="editor-body">
            <div class="code-pane">
              <pre><code><span class="kwd">public class</span> <span class="fn">Solution</span> {
  <span class="kwd">public int</span>[] <span class="fn">TwoSum</span>(<span class="kwd">int</span>[] nums, <span class="kwd">int</span> target) {
    <span class="kwd">var</span> map = <span class="kwd">new</span> Dictionary&lt;<span class="kwd">int</span>, <span class="kwd">int</span>&gt;();
    <span class="kwd">for</span> (<span class="kwd">int</span> i = 0; i &lt; nums.Length; i++) {
      <span class="kwd">int</span> diff = target - nums[i];
      <span class="kwd">if</span> (map.ContainsKey(diff)) {
        <span class="kwd">return new int</span>[] { map[diff], i };
      }
      map[nums[i]] = i;
    }
    <span class="kwd">return</span> Array.Empty&lt;<span class="kwd">int</span>&gt;();
  }
}</code></pre>
            </div>

            <div class="ai-chat-pane">
              <div class="ai-message-header">
                <span class="ai-avatar">IA</span>
                <span class="ai-name">CODELAB Tutor (Context Active)</span>
              </div>
              <div class="ai-message-bubble">
                <p>¡Excelente optimización en C# usando <code>Dictionary</code>! Complejidad reducida a <code>O(n)</code>.</p>
                <p class="hint-box">💡 <strong>Pista de Entrevista:</strong> ¿Cómo manejarías duplicados en el array?</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- SECTION 5: CALL TO ACTION -->
    <section class="section cta-section" id="cta">
      <div class="editorial-container text-center">
        <div class="section-num">04</div>
        <h2 class="editorial-title">EMPIEZA A PRACTICAR</h2>
        <p class="cta-subtitle">Prepárate para tu próxima entrevista técnica con asistencia IA ilimitada.</p>
        <button class="primary-btn" id="start-btn">COMENZAR AHORA</button>
      </div>
    </section>

  </div>

  <!-- Interactive Slide-out Menu Panel -->
  <aside class="menu-drawer" id="menu-drawer">
    <div class="drawer-header">
      <h2>CODELAB // CONTROLES Y CONFIGURACIÓN</h2>
      <button class="close-btn" id="close-menu-btn">&times;</button>
    </div>

    <div class="drawer-body">
      <!-- ASCII Sleeping Cat & Coffee Card -->
      <div class="cat-cafe-card">
        <pre class="ascii-art">
       zZz
      /\_/\       (  )  (   )
     ( -.- )     (  )  (  )
    /  "   " \   [==========]
   (  | | |   )  |  COFFEE  |]
   (__________)  \__________/
        </pre>
        <span class="cat-caption">MIAU... CODELAB FOCUS ZONE ☕</span>
      </div>

      <div class="control-group">
        <h3>MODOS VISUALES ASCII</h3>
        <div class="button-grid">
          <button class="preset-btn active" data-preset="flask">01. MATRAZ DE LABORATORIO (3D)</button>
          <button class="preset-btn" data-preset="dragonfly">02. DRAGONFLY 3D</button>
        </div>
      </div>

      <div class="control-group">
        <h3>PARÁMETROS DE SIMULACIÓN</h3>
        <div class="slider-control">
          <label for="speed-range">Velocidad de Animación</label>
          <input type="range" id="speed-range" min="0" max="3" step="0.1" value="1">
        </div>
        <div class="slider-control">
          <label for="density-range">Densidad de Caracteres ASCII</label>
          <input type="range" id="density-range" min="10" max="40" step="1" value="16">
        </div>
        <div class="slider-control">
          <label for="distortion-range">Interacción del Mouse (Onda)</label>
          <input type="range" id="distortion-range" min="0" max="100" value="50">
        </div>
      </div>

      <div class="control-group">
        <h3>SINTETIZADOR DE RUIDO MARRÓN</h3>
        <div class="benefit-box">
          <strong>🧠 Beneficios del Ruido Marrón (Brown Noise):</strong>
          Genera frecuencias graves profundas y envolventes que reducen la ansiedad, bloquean distracciones del entorno e inducen el estado de <em>hiperfoco (flow)</em> durante la programación.
        </div>
        <button class="audio-btn" id="audio-toggle-btn" style="margin-bottom: 1.2rem;">
          <span class="audio-icon">&#9654;</span> ACTIVAR RUIDO MARRÓN (FOCUS)
        </button>
        <div class="slider-control">
          <label for="volume-range">Volumen del Sonido Ambient</label>
          <input type="range" id="volume-range" min="0" max="1" step="0.01" value="0.5">
        </div>
      </div>
    </div>
  </aside>

  <script src="~/js/home.js" asp-append-version="true"></script>
  <script src="https://cdn.jsdelivr.net/npm/@@supabase/supabase-js@2"></script>
  <script>
    const SUPABASE_URL = "https://bzaifpevfuwlaznmhiee.supabase.co";
    const SUPABASE_ANON_KEY = "sb_publishable_xoU3gGiIKuchm6oTBhr8EQ_eb7sUD2a";
    const supabaseClient = supabase.createClient(SUPABASE_URL, SUPABASE_ANON_KEY);

    supabaseClient.auth.onAuthStateChange((event, session) => {
      const loginBtn = document.getElementById('navLoginBtn');
      const profileBtn = document.getElementById('navProfileBtn');
      if (session?.user) {
        if (loginBtn) loginBtn.style.display = 'none';
        if (profileBtn) profileBtn.style.display = 'inline-block';
      } else {
        if (loginBtn) loginBtn.style.display = 'inline-block';
        if (profileBtn) profileBtn.style.display = 'none';
      }
    });
  </script>
</body>
</html>
