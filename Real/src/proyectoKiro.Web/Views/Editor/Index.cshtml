@{
    ViewData["Title"] = "Editor de Código & Mentores IA - Kiro Code Lab";
}

<div class="app-container">
    <!-- Sidebar Personalidades / Ejercicios -->
    <aside class="sidebar" id="sidebar" aria-hidden="true">
        <div class="sidebar-header">
            <div class="brand">
                <div class="brand-icon">⚡</div>
                <h2>Kiro Code Lab</h2>
            </div>
            <button class="btn-icon mobile-close" id="closeSidebarBtn" type="button" aria-label="Cerrar menú lateral">✕</button>
        </div>

        <div class="personalities-section">
            <div class="section-title-row">
                <h3>Ejercicios & Mentores</h3>
                <button class="btn-add" id="openNewPersonalityModalBtn" title="Crear nuevo ejercicio">+ Nuevo</button>
            </div>
            <p class="section-subtitle">Selecciona un ejercicio para precargar la clase y consultar al mentor IA</p>
            <div class="personalities-list" id="personalitiesList">
                <!-- Dinámico desde JS -->
            </div>
        </div>

        <div class="sidebar-footer">
            <button class="btn-secondary" id="openSettingsModalBtn">
                ⚙️ Configuración (API Keys / Judge0)
            </button>
        </div>
    </aside>

    <button class="sidebar-backdrop" id="sidebarBackdrop" type="button" tabindex="-1" aria-label="Cerrar menú lateral"></button>

    <!-- Main Workspace (Chat Mentor + Monaco Editor) -->
    <div class="workspace-main">
        <!-- Header Bar -->
        <header class="chat-header">
            <button class="btn-icon mobile-menu-btn" id="openSidebarBtn" type="button" aria-label="Abrir menú lateral" aria-controls="sidebar" aria-expanded="false">☰</button>
            
            <div class="active-personality-info" id="activePersonalityDisplay">
                <span class="active-emoji" id="activeEmoji">🔤</span>
                <div>
                    <h2 id="activeName">Ejercicio 1: Invertir Cadena</h2>
                    <span class="active-desc" id="activeDesc">Clase precargada y mentor listo</span>
                </div>
            </div>

            <div class="header-actions">
                <button class="btn-success hidden" id="completeExerciseBtn" title="Guardar ejercicio completado en tu perfil">
                    ✅ Completar Ejercicio
                </button>
                <button class="btn-run" id="runJudge0Btn" title="Compilar y ejecutar en Judge0 API">
                    ▶ Compilar
                </button>
                <button class="btn-test" id="runTestsBtn" title="Ejecutar la suite de pruebas automatizadas del ejercicio">
                    Correr Tests
                </button>
                <button class="btn-outline" id="sendCodeToMentorBtn" title="Enviar el código actual de Monaco al Mentor Gemini">
                    Revisar
                </button>
                <a href="/Profile" class="btn-outline hidden" id="profileBtn" title="Ir a Mi Perfil" style="text-decoration: none; display: inline-flex; align-items: center; gap: 8px;">
                    <img id="headerUserAvatar" src="" style="width: 22px; height: 22px; border-radius: 50%; object-fit: cover; display: none;" referrerpolicy="no-referrer" />
                    <span id="headerProfileLabel">👤 Mi Perfil</span>
                </a>
                <a href="/Auth/Login" class="btn-primary" id="loginHeaderBtn" title="Continuar con Google" style="text-decoration: none; display: inline-flex; align-items: center; gap: 6px;">
                    🔑 Continuar con Google
                </a>
                @* <button class="btn-outline" id="clearChatBtn">🗑️</button>  la ia puso esto para borrar el chat pero lo veo inutil por las dudas lo comento porque la funcionalidad esta pero me da paja buscar xd*@
            </div>
        </header>

        <!-- Split Content: Left Exercise, Center Editor/Terminal, Right AI Tutor -->
        <div class="split-view three-columns">
            <!-- Column 1: Exercise Description Panel -->
            <div class="exercise-panel" id="exercisePanel">
                <button
                    class="panel-collapsed-tab left-collapsed-tab"
                    id="exercisePanelCollapsedTab"
                    type="button"
                    title="Restaurar Enunciado del Ejercicio">
                    <span class="collapsed-tab-icon">📘</span>
                    <span class="collapsed-tab-label">Enunciado</span>
                    <span class="collapsed-tab-arrow">›</span>
                </button>

                <div class="panel-header">
                    <div style="display: flex; align-items: center; gap: 8px;">
                        <span>📘 Enunciado del Ejercicio</span>
                        <div class="exercise-nav-btns" style="display: flex; gap: 4px; margin-left: 4px;">
                            <button type="button" class="btn-font-size" id="prevExerciseBtn" title="Ejercicio Anterior">◀</button>
                            <button type="button" class="btn-font-size" id="nextExerciseBtn" title="Ejercicio Siguiente">▶</button>
                        </div>
                    </div>
                    <div class="font-size-controls">
                        <button type="button" class="btn-font-size" id="decreaseExerciseFontBtn" title="Disminuir tamaño de letra">A-</button>
                        <button type="button" class="btn-font-size" id="increaseExerciseFontBtn" title="Aumentar tamaño de letra">A+</button>
                    </div>
                </div>
                <div class="exercise-content" id="exerciseContent">
                    <!-- Detalle formateado del ejercicio -->
                </div>
            </div>

            <!-- Resizer 1: Left Resizer (Exercise <-> Editor) -->
            <div class="resize-handle workspace-resize-handle" id="leftDivider" role="separator" aria-label="Redimensionar enunciado"></div>

            <!-- Column 2: Monaco Editor & Judge0 Output Console -->
            <div class="editor-panel">
                <div class="panel-header editor-header">
                    <div style="display: flex; align-items: center; gap: 10px;">
                        <span id="editorPanelTitle">💻 Editor de Código</span>
                        <select id="languageSelect" class="lang-select-custom">
                            <option value="csharp" selected>⚡ C#</option>
                            <option value="java">☕ Java</option>
                            <option value="typescript">📘 TypeScript</option>
                        </select>
                    </div>
                    <div class="editor-actions">
                        <div class="font-size-controls">
                            <button type="button" class="btn-font-size" id="decreaseEditorFontBtn" title="Disminuir tamaño de letra">A-</button>
                            <button type="button" class="btn-font-size" id="increaseEditorFontBtn" title="Aumentar tamaño de letra">A+</button>
                        </div>
                        <button class="btn-sm" id="resetStarterCodeBtn">Resetear Código</button>
                    </div>
                </div>

                <!-- Editor Container -->
                <div id="monacoEditorContainer" class="monaco-container"></div>

                <div
                    class="resize-handle terminal-resize-handle"
                    id="editorTerminalDivider"
                    role="separator"
                    aria-label="Redimensionar editor y terminal"
                    aria-orientation="horizontal"
                    aria-valuemin="15"
                    aria-valuemax="65"
                    aria-valuenow="30"
                    tabindex="0">
                </div>

                <!-- Judge0 Terminal Console Output & Test Suite View -->
                <div class="terminal-panel">
                    <div class="terminal-header">
                        <div class="terminal-tabs">
                            <button class="term-tab active" id="tabConsoleBtn">💻 Consola de Salida</button>
                            <button class="term-tab" id="tabTestsBtn">🧪 Pruebas Automatizadas (<span id="testSummaryBadge">0/0</span>)</button>
                        </div>
                        <span class="status-badge" id="judge0StatusBadge">Esperando ejecución...</span>
                    </div>
                    <div class="terminal-content">
                        <pre class="terminal-output" id="terminalOutput">Haz clic en '▶ Compilar' para ejecutar o 'Correr Tests' para validar el ejercicio.</pre>
                        <div class="test-results-container hidden" id="testResultsContainer">
                            <p class="test-placeholder">Presiona <strong>'Correr Tests'</strong> para validar los casos de prueba del ejercicio.</p>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Resizer 2: Right Resizer (Editor <-> Chat Tutor) -->
            <div class="resize-handle workspace-resize-handle" id="rightDivider" role="separator" aria-label="Redimensionar tutor IA"></div>

            <!-- Column 3: Gemini Mentor AI Chat Panel -->
            <div class="chat-panel" id="chatPanel">
                <button
                    class="panel-collapsed-tab right-collapsed-tab"
                    id="chatPanelCollapsedTab"
                    type="button"
                    title="Restaurar Tutor IA">
                    <span class="collapsed-tab-icon">💬</span>
                    <span class="collapsed-tab-label">Tutor IA</span>
                    <span class="collapsed-tab-arrow">‹</span>
                </button>

                <div class="panel-header">
                    <span>🤖 Tutor IA (Gemini)</span>
                    <div class="font-size-controls">
                        <button type="button" class="btn-font-size" id="decreaseChatFontBtn" title="Disminuir tamaño de letra">A-</button>
                        <button type="button" class="btn-font-size" id="increaseChatFontBtn" title="Aumentar tamaño de letra">A+</button>
                    </div>
                </div>
                <div class="chat-messages" id="chatMessages">
                    <!-- Mensajes del chat con la IA -->
                </div>

                <footer class="chat-input-container">
                    <form id="chatForm" class="input-form">
                        <textarea 
                            id="messageInput" 
                            placeholder="Consulta al tutor IA sobre tu código o dudas..." 
                            rows="1"
                            required
                        ></textarea>
                        <button type="button" class="btn-mic" id="micBtn" title="Hablar por micrófono">
                            🎙️
                        </button>
                        <button type="submit" class="btn-send" id="sendBtn">
                            <span></span>
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <line x1="22" y1="2" x2="11" y2="13"></line>
                                <polygon points="22 2 15 22 11 13 2 9 22 2"></polygon>
                            </svg>
                        </button>
                    </form>
                </footer>
            </div>
        </div>
    </div>
</div>

<!-- Modal Crear / Editar Ejercicio / Personalidad -->
<div class="modal-backdrop" id="personalityModal">
    <div class="modal-card">
        <div class="modal-header">
            <h3 id="modalTitle">Crear Nuevo Ejercicio</h3>
            <button class="btn-icon" id="closePersonalityModalBtn">✕</button>
        </div>
        <form id="personalityForm" class="modal-body">
            <input type="hidden" id="editPersonalityId" value="">
            
            <div class="form-row">
                <div class="form-group flex-1">
                    <label for="pEmoji">Ícono / Emoji</label>
                    <input type="text" id="pEmoji" placeholder="ej. 🔤" required value="💻">
                </div>
                <div class="form-group flex-3">
                    <label for="pName">Nombre del Ejercicio</label>
                    <input type="text" id="pName" placeholder="ej. Ejercicio 4: Estructuras" required>
                </div>
            </div>

            <div class="form-group">
                <label for="pDescription">Descripción / Enunciado Breve</label>
                <input type="text" id="pDescription" placeholder="ej. Crea una estructura Alumno..." required>
            </div>

            <div class="form-group">
                <label for="pStarterCode">Código Inicial de la Clase (C#)</label>
                <textarea id="pStarterCode" rows="4" placeholder="using System; ..."></textarea>
            </div>

            <div class="form-group">
                <label for="pSystemInstruction">Reglas & Restricciones para el Mentor</label>
                <textarea id="pSystemInstruction" rows="3" placeholder="RESTRICCIÓN: No puedes utilizar métodos nativos..."></textarea>
            </div>

            <div class="form-group">
                <label for="pTemperature">Temperatura (Creatividad): <span id="tempValue">0.5</span></label>
                <input type="range" id="pTemperature" min="0.0" max="1.0" step="0.1" value="0.5">
            </div>

            <div class="modal-footer">
                <button type="button" class="btn-secondary" id="cancelPersonalityBtn">Cancelar</button>
                <button type="submit" class="btn-primary" id="savePersonalityBtn">Guardar Ejercicio</button>
            </div>
        </form>
    </div>
</div>

<div class="modal-backdrop" id="completeModal">
    <div class="modal-card">
        <div class="modal-header">
            <h3>🎉 ¡Ejercicio Completado!</h3>
            <button class="btn-icon" id="closeCompleteModalBtn">✕</button>
        </div>
        <div class="modal-body">
            <p>Has superado todas las pruebas automatizadas de este ejercicio.</p>
            <p>¿Deseas guardar este progreso y tu solución en tu perfil de usuario?</p>
        </div>
        <div class="modal-footer">
            <button type="button" class="btn-secondary" id="cancelCompleteBtn">Cancelar</button>
            <button type="button" class="btn-primary" id="confirmSaveProgressBtn">Guardar en Mi Perfil</button>
        </div>
    </div>
</div>

<!-- Modal Configuración -->
<div class="modal-backdrop" id="settingsModal">
    <div class="modal-card">
        <div class="modal-header">
            <h3>Configuración de APIs</h3>
            <button class="btn-icon" id="closeSettingsModalBtn">✕</button>
        </div>
        <form id="settingsForm" class="modal-body">
            <div class="form-group">
                <label for="customApiKey">Clave API de Gemini</label>
                <input type="password" id="customApiKey" placeholder="Dejar en blanco para usar la del servidor">
            </div>

            <div class="form-group">
                <label for="modelSelect">Modelo de Gemini</label>
                <select id="modelSelect">
                    <option value="gemini-3.5-flash" selected>gemini-3.5-flash</option>
                    <option value="gemini-2.0-flash">gemini-2.0-flash</option>
                </select>
            </div>

            <div class="form-group">
                <label for="customJudge0Url">URL del Servidor Judge0</label>
                <input type="text" id="customJudge0Url" placeholder="https://ce.judge0.com (por defecto)">
            </div>

            <div class="modal-footer">
                <button type="button" class="btn-secondary" id="cancelSettingsBtn">Cancelar</button>
                <button type="submit" class="btn-primary">Guardar Cambios</button>
            </div>
        </form>
    </div>
</div>

<!-- Modal Iniciar Sesión Requerido -->
<div class="modal-backdrop" id="authRequiredModal">
    <div class="modal-card" style="max-width: 460px;">
        <div class="modal-header">
            <h3>🔑 Inicia Sesión para Continuar</h3>
            <button class="btn-icon" id="closeAuthRequiredModalBtn">✕</button>
        </div>
        <div class="modal-body" style="text-align: center; padding: 25px 20px;">
            <div style="font-size: 38px; margin-bottom: 10px;">🚀</div>
            <h4 style="font-size: 15px; font-weight: 600; margin-bottom: 8px; color: var(--text-main);">¡Desbloquea Kiro Code Lab!</h4>
            <p style="font-size: 13px; color: var(--text-muted); line-height: 1.5; margin-bottom: 22px;">
                Para compilar código en vivo, ejecutar la suite de pruebas automatizadas o consultar al Tutor IA, inicia sesión con tu cuenta de Google.
            </p>
            <div style="display: flex; gap: 10px; justify-content: center;">
                <button type="button" class="btn-secondary" id="cancelAuthRequiredBtn">Cancelar</button>
                <a href="/Auth/Login" class="btn-primary" style="text-decoration: none;">🔑 Continuar con Google</a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <!-- Supabase JS Client para la sesión de usuario -->
    <script src="https://cdn.jsdelivr.net/npm/@@supabase/supabase-js@2"></script>
    <script>
        const SUPABASE_URL = "https://bzaifpevfuwlaznmhiee.supabase.co";
        const SUPABASE_ANON_KEY = "sb_publishable_xoU3gGiIKuchm6oTBhr8EQ_eb7sUD2a";
        window.supabaseClient = supabase.createClient(SUPABASE_URL, SUPABASE_ANON_KEY);
        
        window.supabaseClient.auth.onAuthStateChange((event, session) => {
            if (session?.user) {
                window.currentUserId = session.user.id;
                if (typeof window.onUserAuthenticated === 'function') {
                    window.onUserAuthenticated(session.user.id);
                }
            }
        });
    </script>

    <!-- Módulos Vanilla JS de Kiro -->
    <script src="~/js/editor.js" asp-append-version="true"></script>
    <script src="~/js/ejercicios.js" asp-append-version="true"></script>
    <script src="~/js/modules/ui.js" asp-append-version="true"></script>
    <script src="~/js/modules/chat.js" asp-append-version="true"></script>
    <script src="~/js/modules/voice.js" asp-append-version="true"></script>
    <script src="~/js/modules/judge0.js" asp-append-version="true"></script>
    <script src="~/js/modules/submissions.js" asp-append-version="true"></script>
    <script src="~/js/modules/modals.js" asp-append-version="true"></script>
    <!-- Orquestador Principal -->
    <script src="~/js/main.js" asp-append-version="true"></script>
}
